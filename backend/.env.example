# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Banco (opcional)
#--------------------------------------------------------------------
# Sem nada aqui, o banco é SQLite em tmp/db.sqlite3. Em produção (Render) o banco é o Postgres
# do Supabase: DB_CONNECTION=pg e o endereço do Session pooler em DATABASE_URL.
# Nunca aponte os testes para o Supabase: a suíte apaga as tabelas.
# DB_CONNECTION=pg
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# DB_SSL=false

#--------------------------------------------------------------------
# Entrar com o Google (opcional)
#--------------------------------------------------------------------
# Credencial "Aplicativo da Web" do Google Cloud, com o URI de redirecionamento
# ${APP_URL}/api/v1/auth/google/callback (aqui: http://localhost:3333/api/v1/auth/google/callback).
# Sem o client ID e o segredo, o botão avisa que o login com o Google não está disponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço do front, para onde a volta do Google leva a pessoa
FRONTEND_URL=http://localhost:3000

#--------------------------------------------------------------------
# Lembretes por e-mail (opcional)
#--------------------------------------------------------------------
# Chave de API do Brevo (brevo.com, plano gratuito) e um remetente verificado lá.
# Sem os dois, o lembrete só aparece no sistema. Contas @agenda.test nunca recebem e-mail.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Agenda Acadêmica

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional JSON feed used by "node ace calendar:sync-official --source=..."
# INSTITUTIONAL_CALENDAR_URL=https://example.edu/calendar.json

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Entrar com o Google (opcional)
#--------------------------------------------------------------------
# Credencial "Aplicativo da Web" do Google Cloud, com o URI de redirecionamento
# ${APP_URL}/api/v1/auth/google/callback (aqui: http://localhost:3333/api/v1/auth/google/callback).
# Sem o client ID e o segredo, o botão avisa que o login com o Google não está disponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço do front, para onde a volta do Google leva a pessoa
FRONTEND_URL=http://localhost:3000

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional JSON feed used by "node ace calendar:sync-official --source=..."
# INSTITUTIONAL_CALENDAR_URL=https://example.edu/calendar.json
